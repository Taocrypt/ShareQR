<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".ShareQrActivity">

    <!-- Blur/dim layer behind dialog -->
    <View
        android:id="@+id/blurLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true" />

    <!-- Centered dialog card -->
    <LinearLayout android:id="@+id/dialogContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_dialog_card">



        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="40dp"
            android:layout_marginBottom="10dp" />

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:adjustViewBounds="true"
            android:layout_marginBottom="12dp"
            android:scaleType="centerInside"
            android:background="@android:color/white"
            tools:src="@mipmap/ic_launcher" />



        <TextView
            android:id="@+id/tvCopied"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.87"
            android:textIsSelectable="true"
            android:ellipsize="end"
            android:maxLines="4"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@android:color/transparent"
            tools:text="https://example.com/hello" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button"
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存到本地"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</FrameLayout>
